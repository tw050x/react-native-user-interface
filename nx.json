{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "targetDefaults": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "production",
        "^production"
      ],
      "cache": true
    },
    "test": [
      {
        "filter": {
          "plugin": "@nx/jest/plugin"
        },
        "configurations": {
          "ci": {
            "ci": true,
            "coverage": true
          }
        },
        "options": {
          "passWithNoTests": true
        }
      }
    ]
  },
  "namedInputs": {
    "default": [
      "{projectRoot}/**/*",
      "sharedGlobals"
    ],
    "production": [
      "default",
      "!{projectRoot}/**/?(*.)+(spec|test).[jt]s?(x)?(.snap)",
      "!{projectRoot}/tsconfig.spec.json",
      "!{projectRoot}/jest.config.[jt]s",
      "!{projectRoot}/eslint.config.mjs",
      "!{projectRoot}/src/test-setup.[jt]s"
    ],
    "sharedGlobals": [
      "{workspaceRoot}/babel.config.json"
    ]
  },
  "defaultProject": "react-native-user-interface",
  "generators": {
    "@nx/react": {
      "application": {
        "babel": true
      }
    }
  },
  "useInferencePlugins": false,
  "defaultBase": "main",
  "affected": {
    "legacy": true
  },
  "plugins": [
    {
      "plugin": "@nx/eslint/plugin",
      "options": {
        "targetName": "lint"
      }
    },
    {
      "plugin": "@nx/jest/plugin",
      "options": {
        "targetName": "test"
      }
    },
    {
      "plugin": "@nx/detox/plugin",
      "options": {
        "buildTargetName": "e2e-build",
        "startTargetName": "e2e-start",
        "testTargetName": "e2e"
      }
    },
    {
      "plugin": "@nx/react-native/plugin",
      "options": {
        "startTargetName": "start",
        "upgradeTargetName": "update",
        "bundleTargetName": "bundle",
        "podInstallTargetName": "pod-install",
        "runIosTargetName": "run-ios",
        "runAndroidTargetName": "run-android",
        "buildIosTargetName": "build-ios",
        "buildAndroidTargetName": "build-android",
        "syncDepsTargetName": "sync-deps"
      }
    },
    {
      "plugin": "@nx/js/typescript",
      "options": {
        "typecheck": {
          "targetName": "typecheck"
        }
      }
    }
  ],
  "release": {
    "projects": [
      "date-picker-modal",
      "time-picker-modal"
    ],
    "projectsRelationship": "independent",
    "releaseTag": {
      "pattern": "{projectName}@{version}"
    },
    "conventionalCommits": {
      "types": {
        "Breaking": {
          "semverBump": "major",
          "changelog": {
            "title": "Breaking changes"
          }
        },
        "Feature": {
          "semverBump": "minor",
          "changelog": {
            "title": "Features"
          }
        },
        "New": {
          "semverBump": "minor",
          "changelog": {
            "title": "Features"
          }
        },
        "Upgrade": {
          "semverBump": "minor",
          "changelog": {
            "title": "Upgrades"
          }
        },
        "Update": {
          "semverBump": "minor",
          "changelog": {
            "title": "Updates"
          }
        },
        "Fix": {
          "semverBump": "patch",
          "changelog": {
            "title": "Fixes"
          }
        },
        "Docs": {
          "semverBump": "patch",
          "changelog": {
            "title": "Documentation"
          }
        },
        "Chore": {
          "semverBump": "none",
          "changelog": false
        },
        "Build": {
          "semverBump": "none",
          "changelog": false
        },
        "Release": {
          "semverBump": "none",
          "changelog": false
        }
      }
    },
    "version": {
      "currentVersionResolver": "disk",
      "preVersionCommand": "yarn nx run-many -t build -p date-picker-modal,time-picker-modal",
      "manifestRootsToUpdate": [
        "{projectRoot}",
        "dist/libs/@react-native-user-interface/{projectName}"
      ]
    },
    "changelog": {
      "workspaceChangelog": false,
      "projectChangelogs": {
        "file": false,
        "createRelease": "github"
      }
    },
    "git": {
      "commitMessage": "Release: {projectName}@{version}"
    }
  }
}
