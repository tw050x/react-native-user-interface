{
  "name": "react-native-user-interface",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/react-native-user-interface/src",
  "projectType": "application",
  "tags": [],
  "targets": {
    "start": {
      "executor": "@nx/react-native:start",
      "options": {
        "port": 8081
      },
      "dependsOn": ["sync-deps", "pod-install"]
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "nx start react-native-user-interface"
      }
    },
    "run-ios": {
      "executor": "@nx/react-native:run-ios",
      "options": {
        "simulator": "iPhone 14 Pro Max"
      },
      "dependsOn": ["sync-deps", "pod-install"]
    },
    "bundle-ios": {
      "executor": "@nx/react-native:bundle",
      "options": {
        "entryFile": "src/main.tsx",
        "platform": "ios",
        "bundleOutput": "dist/apps/react-native-user-interface/ios/main.jsbundle"
      },
      "dependsOn": []
    },
    "run-android": {
      "executor": "@nx/react-native:run-android",
      "options": {},
      "dependsOn": ["sync-deps"]
    },
    "build-android": {
      "executor": "@nx/react-native:build-android",
      "outputs": [
        "{projectRoot}/android/app/build/outputs/bundle",
        "{projectRoot}/android/app/build/outputs/apk"
      ],
      "options": {},
      "dependsOn": ["sync-deps"]
    },
    "bundle-android": {
      "executor": "@nx/react-native:bundle",
      "options": {
        "entryFile": "src/main.tsx",
        "platform": "android",
        "bundleOutput": "dist/apps/react-native-user-interface/android/main.jsbundle"
      },
      "dependsOn": []
    },
    "sync-deps": {
      "executor": "@nx/react-native:sync-deps",
      "options": {}
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"]
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "apps/react-native-user-interface/jest.config.ts"
      }
    },
    "upgrade": {
      "executor": "@nx/react-native:upgrade",
      "options": {}
    }
  }
}
