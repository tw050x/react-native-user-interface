{
  "name": "react-native-user-interface-e2e",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/react-native-user-interface-e2e/src",
  "projectType": "application",
  "tags": [],
  "implicitDependencies": [
    "react-native-user-interface"
  ],
  "targets": {
    "build-ios": {
      "command": "nx run react-native-user-interface-e2e:e2e-build -- --configuration ios.sim.debug",
      "configurations": {
        "production": {
          "command": "nx run react-native-user-interface-e2e:e2e-build -- --configuration ios.sim.release"
        }
      }
    },
    "test-ios": {
      "command": "nx run react-native-user-interface-e2e:e2e -- --configuration ios.sim.debug",
      "configurations": {
        "production": {
          "command": "nx run react-native-user-interface-e2e:e2e -- --configuration ios.sim.release"
        }
      },
      "dependsOn": [
        "build-ios"
      ]
    },
    "build-android": {
      "command": "nx run react-native-user-interface-e2e:e2e-build -- --configuration android.emu.debug",
      "configurations": {
        "production": {
          "command": "nx run react-native-user-interface-e2e:e2e-build -- --configuration android.emu.release"
        }
      }
    },
    "test-android": {
      "command": "nx run react-native-user-interface-e2e:e2e -- --configuration android.emu.debug",
      "configurations": {
        "production": {
          "command": "nx run react-native-user-interface-e2e:e2e -- --configuration android.emu.release"
        }
      },
      "dependsOn": [
        "build-android"
      ]
    }
  }
}
